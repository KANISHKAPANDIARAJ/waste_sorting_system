# Flask Config
SECRET_KEY=supersecretkeyreplaceinproduction
FLASK_APP=app.py
FLASK_ENV=development

# Database Config
DATABASE_URL=sqlite:///waste_system.db

# File Upload Configuration
UPLOAD_FOLDER=uploads/waste
MAX_CONTENT_LENGTH=16777216  # 16 MB max upload size

# Business Logic Thresholds
CLASSIFICATION_THRESHOLD=0.70
BIN_WARNING_THRESHOLD=70
BIN_FULL_THRESHOLD=90

# IoT Simulator Configuration
SIMULATOR_INTERVAL=5
DEVICE_ID=SIM-001
DEVICE_NAME=Main Unit
DEVICE_LOCATION=Conveyor Line A
